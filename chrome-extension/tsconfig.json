{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["chrome"],
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["popup/**/*.ts", "background/**/*.ts", "lib/**/*.ts", "types/**/*.ts"]
}
